    </bpmn:laneSet>
    <bpmn:startEvent id="Event_0hq7ehn" name="Payment requested">
      <bpmn:documentation>Receives the checkout Message Send connector payload, including orderId, paymentAmount, basket/customer identifiers and producer sub-orders. Starting independently with empty variables applies demo defaults.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="= if orderId != null and string(orderId) != &quot;&quot; then string(orderId) else &quot;ORD-1001&quot;" target="orderId" />
          <zeebe:output source="= if basketId != null and string(basketId) != &quot;&quot; then string(basketId) else &quot;BASKET-1001&quot;" target="basketId" />
          <zeebe:output source="= if customerId != null and string(customerId) != &quot;&quot; then string(customerId) else &quot;CUST-001&quot;" target="customerId" />
          <zeebe:output source="= if productId != null and string(productId) != &quot;&quot; then string(productId) else &quot;apple-box&quot;" target="productId" />
          <zeebe:output source="= if requestedQuantity instance of number then requestedQuantity else if requestedQuantity != null and number(string(requestedQuantity)) != null then number(string(requestedQuantity)) else 5" target="requestedQuantity" />
          <zeebe:output source="= if paymentAmount instance of number and paymentAmount &gt; 0 then paymentAmount else if paymentAmount != null and number(string(paymentAmount)) != null and number(string(paymentAmount)) &gt; 0 then number(string(paymentAmount)) else 18.5" target="paymentAmount" />
          <zeebe:output source="= if orderProducers != null and count(orderProducers) &gt; 0 then orderProducers else [&quot;hillside-farm&quot;, &quot;bristol-bakery&quot;]" target="orderProducers" />
          <zeebe:output source="= if producerSubOrders != null then producerSubOrders else [{ producerId: &quot;hillside-farm&quot;, orderId: &quot;ORD-1001&quot;, status: &quot;CREATED&quot; }, { producerId: &quot;bristol-bakery&quot;, orderId: &quot;ORD-1001&quot;, status: &quot;CREATED&quot; }]" target="producerSubOrders" />
          <zeebe:output source="= if producerSummary != null then producerSummary else &quot;Hillside Farm: apple-box (12.50 GBP); Bristol Bakery: bread-loaf (6.00 GBP)&quot;" target="producerSummary" />
          <zeebe:output source="= if deliveryArrangementsSummary != null then deliveryArrangementsSummary else &quot;Hillside Farm: home delivery Thursday; Bristol Bakery: collection Friday&quot;" target="deliveryArrangementsSummary" />
        </zeebe:ioMapping>
        <zeebe:properties>
          <zeebe:property name="camundaModeler:exampleOutputJson" value="{ &quot;orderId&quot;: &quot;ORD-1001&quot;, &quot;basketId&quot;: &quot;BASKET-1001&quot;, &quot;customerId&quot;: &quot;CUST-001&quot;, &quot;paymentAmount&quot;: 18.5, &quot;orderProducers&quot;: [&quot;hillside-farm&quot;, &quot;bristol-bakery&quot;] }" />
        </zeebe:properties>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_0f9ee59</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_0p4r9k1" messageRef="Message_1p7r3m9" />
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="Gateway_0firheg">
      <bpmn:incoming>Flow_0f9ee59</bpmn:incoming>
      <bpmn:incoming>Flow_0cgul02</bpmn:incoming>
      <bpmn:outgoing>Flow_1woxn6a</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Activity_11o648p" name="Send payment request">
      <bpmn:documentation>The input mappings prepare paymentRequestId before the worker sends the request. Include this ID in the external request. The response must publish Payment result with this correlation key and paymentSuccessful set to true or false. In Play/Test, complete this job, then publish the response at the message catch event. Job completion alone is not a payment response.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-payment-request" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="= assert(orderId, orderId != null and string(orderId) != &quot;&quot;, &quot;Payment request requires a non-empty orderId&quot;)" target="orderId" />
          <zeebe:input source="= if paymentRetryCount = null then 0 else paymentRetryCount" target="paymentRetryCount" />
          <zeebe:input source="= &quot;PAY-&quot; + string(orderId) + &quot;-&quot; + string(paymentRetryCount + 1)" target="paymentRequestId" />
          <zeebe:output source="= paymentRetryCount" target="paymentRetryCount" />
          <zeebe:output source="= paymentRequestId" target="paymentRequestId" />
          <zeebe:output source="= null" target="paymentSuccessful" />
          <zeebe:output source="= null" target="paymentReference" />
          <zeebe:output source="= null" target="paymentFailureReason" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1woxn6a</bpmn:incoming>
      <bpmn:outgoing>Flow_10jzafl</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:eventBasedGateway id="Gateway_0ehteoe" name="Wait for payment response">
      <bpmn:incoming>Flow_10jzafl</bpmn:incoming>
      <bpmn:outgoing>Flow_045z480</bpmn:outgoing>
      <bpmn:outgoing>Flow_1vsm1bq</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="Event_0w68vfx" name="Payment result received">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="= assert(string(paymentSuccessful), list contains([&quot;true&quot;, &quot;false&quot;], string(paymentSuccessful)), &quot;Payment result must include paymentSuccessful: true or false&quot;) = &quot;true&quot;" target="paymentSuccessful" />
          <zeebe:output source="= paymentReference" target="paymentReference" />
          <zeebe:output source="= paymentFailureReason" target="paymentFailureReason" />
        </zeebe:ioMapping>
        <zeebe:properties>
          <zeebe:property name="camundaModeler:exampleOutputJson" value="{ &quot;paymentSuccessful&quot;: true, &quot;paymentReference&quot;: &quot;TXN-5001&quot; }" />
        </zeebe:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_045z480</bpmn:incoming>
      <bpmn:outgoing>Flow_0goejso</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_1j3u2ur" messageRef="Message_0p4r9s2" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gateway_1dznhq9" name="Payment successful?" default="Flow_1evabmh">
      <bpmn:incoming>Flow_0goejso</bpmn:incoming>
      <bpmn:outgoing>Flow_1evabmh</bpmn:outgoing>
      <bpmn:outgoing>Flow_0v7w32u</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Activity_1fcdhs8" name="Notify customer of payment decline">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="notify-customer-payment-decline" retries="3" />
        <zeebe:ioMapping>
          <zeebe:output source="= paymentRetryCount + 1" target="paymentRetryCount" />
          <zeebe:output source="= if paymentFailureReason = null then &quot;Payment declined by the payment service&quot; else paymentFailureReason" target="paymentFailureReason" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1evabmh</bpmn:incoming>
      <bpmn:outgoing>Flow_08bytgq</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="Event_19gjzzt" name="Payment response timeout">
      <bpmn:incoming>Flow_1vsm1bq</bpmn:incoming>
      <bpmn:outgoing>Flow_037fgi1</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_19vwjku">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT2M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="Activity_1mcyc36" name="Record payment service unavailable">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="record-payment-service-unavailable" retries="3" />
        <zeebe:ioMapping>
          <zeebe:output source="= paymentRetryCount + 1" target="paymentRetryCount" />
          <zeebe:output source="= &quot;No response from the payment service within 2 minutes&quot;" target="paymentFailureReason" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_037fgi1</bpmn:incoming>
      <bpmn:outgoing>Flow_0044xu8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_0r2yijp" name="Notify customer of payment issue">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="notify-customer-payment-issue" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0044xu8</bpmn:incoming>
      <bpmn:outgoing>Flow_122zdr9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_0rw679i">
      <bpmn:incoming>Flow_08bytgq</bpmn:incoming>
      <bpmn:incoming>Flow_122zdr9</bpmn:incoming>
      <bpmn:outgoing>Flow_1649jwv</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Event_1518y8h" name="Review payment issue and retry or cancel">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="form-retry-or-cancel-payment" />
        <zeebe:ioMapping>
          <zeebe:input source="= false" target="retryPayment" />
          <zeebe:output source="= retryPayment = true and paymentRetryCount &lt; 3" target="retryPayment" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1649jwv</bpmn:incoming>
      <bpmn:outgoing>Flow_0rxly45</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="Event_payment_decision_timeout" name="Decision timeout (15m)" attachedToRef="Event_1518y8h">
      <bpmn:outgoing>Flow_payment_decision_timeout</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_payment_decision_timeout">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT15M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:exclusiveGateway id="Gateway_1murdgd" name="Retry payment? (failures &#60; 3)" default="Flow_15ze7n2">
      <bpmn:incoming>Flow_0rxly45</bpmn:incoming>
      <bpmn:outgoing>Flow_0cgul02</bpmn:outgoing>
      <bpmn:outgoing>Flow_15ze7n2</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Activity_0ony9r5" name="Cancel order">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="cancel-order" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_15ze7n2</bpmn:incoming>
      <bpmn:incoming>Flow_payment_decision_timeout</bpmn:incoming>
      <bpmn:outgoing>Flow_0qivndt</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_0r8l2s4" name="Release stock reservation">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="release-stock-reservation" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0qivndt</bpmn:incoming>
      <bpmn:outgoing>Flow_1r8l2e4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Event_18z0rku" name="Payment cancelled">
      <bpmn:incoming>Flow_1r8l2e4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Activity_0xl8z96" name="Confirm order">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="confirm-order" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0v7w32u</bpmn:incoming>
      <bpmn:outgoing>Flow_0rg641h</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_06hysle" name="Update inventory">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="update-inventory" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0rg641h</bpmn:incoming>
      <bpmn:outgoing>Flow_1tas4qy</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_1dy4nj7" name="Send order confirmation">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-order-confirmation" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1tas4qy</bpmn:incoming>
      <bpmn:outgoing>Flow_1di5q7x</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_1hftzgu" name="Notify producers">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="notify-producers" retries="3" />
        <zeebe:ioMapping>
          <zeebe:output source="= &quot;SENT&quot;" target="producerNotificationStatus" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1di5q7x</bpmn:incoming>
      <bpmn:outgoing>Flow_09sxvfc</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="Event_16ewxp0" name="Producer notification failed" attachedToRef="Activity_1hftzgu">
      <bpmn:outgoing>Flow_0ffhmtr</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_1ocvajy" errorRef="Error_0p8n3f2" />
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="Activity_08poptu" name="Record notification failure">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="record-notification-failure" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0ffhmtr</bpmn:incoming>
      <bpmn:outgoing>Flow_17gvn4p</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_0sd3hei" name="Retry producer notification">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="retry-producer-notification" retries="3" />
        <zeebe:ioMapping>
          <zeebe:output source="= &quot;SENT_ON_RETRY&quot;" target="producerNotificationStatus" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_17gvn4p</bpmn:incoming>
      <bpmn:outgoing>Flow_05e9yju</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="Event_0r9n4f2" name="Notification retry failed" attachedToRef="Activity_0sd3hei">
      <bpmn:outgoing>Flow_0r7n2m5</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_0r9n4f2" errorRef="Error_0p8n3f2" />
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="Activity_1f6n2m8" name="Flag notification for manual follow-up">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="flag-producer-notification-followup" retries="3" />
        <zeebe:ioMapping>
          <zeebe:output source="= &quot;MANUAL_FOLLOWUP_REQUIRED&quot;" target="producerNotificationStatus" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0r7n2m5</bpmn:incoming>
      <bpmn:outgoing>Flow_1f8n4g2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_1gcqj3j">
      <bpmn:incoming>Flow_09sxvfc</bpmn:incoming>
      <bpmn:incoming>Flow_05e9yju</bpmn:incoming>
      <bpmn:incoming>Flow_1f8n4g2</bpmn:incoming>
      <bpmn:outgoing>Flow_0d8dh2g</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:scriptTask id="Activity_1y8jt4y" name="Calculate 5% commission">
      <bpmn:extensionElements>
        <zeebe:script expression="= round half up((if paymentAmount instance of number then paymentAmount else 18.5) * 0.05, 2)" resultVariable="commissionAmount" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0d8dh2g</bpmn:incoming>
      <bpmn:outgoing>Flow_0hsy971</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:scriptTask id="Activity_0a8ae8l" name="Calculate producer allocation">
      <bpmn:extensionElements>
        <zeebe:script expression="= { netTotal: round half up((if paymentAmount instance of number then paymentAmount else 18.5) - commissionAmount, 2), producerCount: if orderProducers != null and count(orderProducers) &gt; 0 then count(orderProducers) else 1 }" resultVariable="allocationSummary" />
        <zeebe:ioMapping>
          <zeebe:output source="= allocationSummary.netTotal" target="producerNetTotal" />
          <zeebe:output source="= if orderProducers != null and count(orderProducers) &gt; 0 then for i in 1..count(orderProducers) return { producerId: orderProducers[i], netShare: if i &lt; count(orderProducers) then round half up(allocationSummary.netTotal / allocationSummary.producerCount, 2) else round half up(allocationSummary.netTotal - round half up(allocationSummary.netTotal / allocationSummary.producerCount, 2) * (allocationSummary.producerCount - 1), 2) } else [{ producerId: &quot;default-producer&quot;, netShare: allocationSummary.netTotal }]" target="producerAllocations" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0hsy971</bpmn:incoming>
      <bpmn:outgoing>Flow_0ao56xm</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:serviceTask id="Activity_0thxxf3" name="Record pending settlements">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="record-pending-settlements" retries="3" />
        <zeebe:ioMapping>
          <zeebe:output source="= true" target="pendingSettlementRecorded" />
          <zeebe:output source="= &quot;PENDING_WEEKLY_SETTLEMENT&quot;" target="settlementStatus" />
        </zeebe:ioMapping>
        <zeebe:properties>
          <zeebe:property name="camundaModeler:exampleOutputJson" value="{ &quot;pendingSettlementRecorded&quot;: true }" />
        </zeebe:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0ao56xm</bpmn:incoming>
      <bpmn:outgoing>Flow_0tgs6x2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Event_0aqzf4c" name="Payment completed">
      <bpmn:incoming>Flow_0tgs6x2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Activity_076120z" name="Retrieve pending settlements">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="retrieve-pending-settlements" retries="3" />
        <zeebe:ioMapping>
          <zeebe:output source="= 0" target="settlementRetryCount" />
          <zeebe:output source="= if pendingSettlementsFound = false or string(pendingSettlementsFound) = &quot;false&quot; then false else true" target="pendingSettlementsFound" />
          <zeebe:output source="= if settlementBatchId != null and string(settlementBatchId) != &quot;&quot; then string(settlementBatchId) else &quot;SETTLEMENT-2026-W47&quot;" target="settlementBatchId" />
        </zeebe:ioMapping>
        <zeebe:properties>
          <zeebe:property name="camundaModeler:exampleOutputJson" value="{ &quot;pendingSettlementsFound&quot;: true, &quot;settlementBatchId&quot;: &quot;SETTLEMENT-2026-W47&quot; }" />
        </zeebe:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_12nhqmj</bpmn:incoming>
      <bpmn:outgoing>Flow_1w1xxn5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_0hkpwwc" name="Pending settlements found?" default="Flow_04a16lc">
      <bpmn:incoming>Flow_1w1xxn5</bpmn:incoming>
      <bpmn:outgoing>Flow_18w1gqb</bpmn:outgoing>
      <bpmn:outgoing>Flow_04a16lc</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Event_1su7jrz" name="No settlements due">
      <bpmn:incoming>Flow_04a16lc</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Activity_10xhfgd" name="Initiate weekly producer settlements">
      <bpmn:documentation>Send settlementRequestId with the external request. The payment service must publish Settlement result using that correlation key and a settlementSuccessful boolean. In Play/Test, publish the response at Wait for settlement result after completing this job.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="initiate-weekly-settlements" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="= assert(settlementBatchId, settlementBatchId != null and string(settlementBatchId) != &quot;&quot;, &quot;Settlement request requires a non-empty settlementBatchId&quot;)" target="settlementBatchId" />
          <zeebe:input source="= if settlementRetryCount = null then 0 else settlementRetryCount" target="settlementRetryCount" />
          <zeebe:input source="= &quot;SET-&quot; + string(settlementBatchId) + &quot;-&quot; + string(settlementRetryCount + 1)" target="settlementRequestId" />
          <zeebe:output source="= settlementRetryCount" target="settlementRetryCount" />
          <zeebe:output source="= settlementRequestId" target="settlementRequestId" />
          <zeebe:output source="= null" target="settlementSuccessful" />
          <zeebe:output source="= null" target="settlementFailureReason" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_18w1gqb</bpmn:incoming>
      <bpmn:outgoing>Flow_0ewlt0d</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_1bvt51m">
      <bpmn:incoming>Flow_09zcm2m</bpmn:incoming>
      <bpmn:incoming>Flow_0ewlt0d</bpmn:incoming>
      <bpmn:outgoing>Flow_08vw8vc</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:receiveTask id="Event_0opm2xd" name="Wait for settlement result" messageRef="Message_0s8r2m4">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="= assert(string(settlementSuccessful), list contains([&quot;true&quot;, &quot;false&quot;], string(settlementSuccessful)), &quot;Settlement result must include settlementSuccessful: true or false&quot;) = &quot;true&quot;" target="settlementSuccessful" />
          <zeebe:output source="= settlementFailureReason" target="settlementFailureReason" />
        </zeebe:ioMapping>
        <zeebe:properties>
          <zeebe:property name="camundaModeler:exampleOutputJson" value="{ &quot;settlementSuccessful&quot;: true }" />
        </zeebe:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_08vw8vc</bpmn:incoming>
      <bpmn:outgoing>Flow_1i82xnf</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:boundaryEvent id="Event_settlement_timeout" name="Settlement response timeout (2m)" attachedToRef="Event_0opm2xd">
      <bpmn:outgoing>Flow_settlement_timeout</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_settlement_timeout">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT2M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:exclusiveGateway id="Gateway_1e7icdg" name="Settlement successful?" default="Flow_06md1wo">
      <bpmn:incoming>Flow_1i82xnf</bpmn:incoming>
      <bpmn:outgoing>Flow_0n2pw74</bpmn:outgoing>
      <bpmn:outgoing>Flow_06md1wo</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Activity_0yc85u4" name="Record settlement failure">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="record-settlement-failure" retries="3" />
        <zeebe:ioMapping>
          <zeebe:output source="= settlementRetryCount + 1" target="settlementRetryCount" />
          <zeebe:output source="= if settlementFailureReason = null then &quot;Settlement failed or no response from the payment service within 2 minutes&quot; else settlementFailureReason" target="settlementFailureReason" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_06md1wo</bpmn:incoming>
      <bpmn:incoming>Flow_settlement_timeout</bpmn:incoming>
      <bpmn:outgoing>Flow_1hdfqsg</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Activity_09pfawo" name="Review failed settlement">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="form-review-failed-settlement" />
        <zeebe:ioMapping>
          <zeebe:input source="= false" target="retrySettlement" />
          <zeebe:output source="= retrySettlement = true and settlementRetryCount &lt; 3" target="retrySettlement" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1hdfqsg</bpmn:incoming>
      <bpmn:outgoing>Flow_1mrs81w</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_0hcxgmn" name="Retry settlement? (failures &#60; 3)" default="Flow_0jdal4y">
