      <bpmn:outgoing>Flow_1sb2d8m</bpmn:outgoing>
      <bpmn:outgoing>Flow_0jdal4y</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Activity_1jjppln" name="Retry failed settlements">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="retry-failed-settlements" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="= &quot;SET-&quot; + string(settlementBatchId) + &quot;-&quot; + string(settlementRetryCount + 1)" target="settlementRequestId" />
          <zeebe:output source="= settlementRequestId" target="settlementRequestId" />
          <zeebe:output source="= null" target="settlementSuccessful" />
          <zeebe:output source="= null" target="settlementFailureReason" />
