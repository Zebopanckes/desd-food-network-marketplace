    <bpmn:messageFlow id="Flow_0m4r8l2" name="Release stock" sourceRef="Activity_0r8l2s4" targetRef="Participant_1s6t3k8" />
  </bpmn:collaboration>
  <bpmn:process id="Process_0r99cf8" name="Marketplace Payment and Settlement (Functionality 2)" isExecutable="true">
    <bpmn:laneSet id="LaneSet_0wyd6b6">
      <bpmn:lane id="Lane_1p5i9m3" name="Product and Inventory Management">
        <bpmn:flowNodeRef>Activity_06hysle</bpmn:flowNodeRef>
