    <bpmn:messageFlow id="Flow_0sdz6h2" name="Payment unavailable notice" sourceRef="Activity_0r2yijp" targetRef="Participant_052xb10" />
    <bpmn:messageFlow id="Flow_0m8r3c5" name="Retry or cancel decision" sourceRef="Participant_052xb10" targetRef="Event_1518y8h" />
    <bpmn:messageFlow id="Flow_1975j1q" name="Retried producer order" sourceRef="Activity_0sd3hei" targetRef="Participant_1wfa956" />
