{
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.9.0",
  "exporter": {
    "name": "Camunda Web Modeler",
    "version": "64767e4"
  },
  "schemaVersion": 16,
  "id": "form-review-failed-settlement",
  "components": [
    {
      "text": "### Review Failed Weekly Producer Settlement\nInspect the settlement failure details and decide whether to retry the settlement batch or flag it for manual follow-up.",
      "type": "text",
      "id": "Field_Header_Settlement",
      "layout": {
        "row": "Row_0",
        "columns": null
      }
    },
    {
      "label": "Settlement Batch ID",
      "type": "textfield",
      "id": "Field_SettlementBatchId",
      "key": "settlementBatchId",
      "readonly": true,
      "layout": {
        "row": "Row_1",
        "columns": null
      }
    },
    {
      "label": "Failure details",
      "type": "textfield",
      "id": "Field_SettlementFailure",
      "key": "settlementFailureReason",
      "readonly": true,
      "layout": {
        "row": "Row_Details",
        "columns": null
      }
    },
    {
      "label": "Failed attempts (maximum 3)",
      "type": "number",
      "id": "Field_SettlementRetryCount",
      "key": "settlementRetryCount",
      "readonly": true,
      "layout": {
        "row": "Row_Attempts",
        "columns": null
      }
    },
    {
      "text": "**Maximum settlement attempts (3) reached.** Submitting this form will flag the batch for manual follow-up.",
      "type": "text",
      "id": "Field_MaxSettlementRetriesNotice",
      "conditional": {
        "hide": "= settlementRetryCount = null or settlementRetryCount < 3"
      },
      "layout": {
        "row": "Row_MaxNotice",
        "columns": null
      }
    },
    {
      "label": "Retry failed settlement batch",
      "type": "checkbox",
      "id": "Field_RetrySettlement",
      "key": "retrySettlement",
      "description": "Check to retry; leave unchecked for manual follow-up.",
      "defaultValue": false,
      "conditional": {
        "hide": "= settlementRetryCount != null and settlementRetryCount >= 3"
      },
      "layout": {
        "row": "Row_2",
        "columns": null
      }
    }
  ],
  "type": "default"
}