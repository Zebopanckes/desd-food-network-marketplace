{
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.9.0",
  "exporter": {
    "name": "Camunda Web Modeler",
    "version": "64767e4"
  },
  "schemaVersion": 16,
  "id": "form-remove-or-replace-product",
  "components": [
    {
      "text": "### Remove or Replace Unavailable Product\nSelect whether to remove the out-of-stock item from your basket or substitute it with an alternative producer product.",
      "type": "text",
      "id": "Field_Header_Replace",
      "layout": {
        "row": "Row_0",
        "columns": null
      }
    },
    {
      "label": "Basket ID",
      "type": "textfield",
      "id": "Field_BasketId_Replace",
      "key": "basketId",
      "readonly": true,
      "layout": {
        "row": "Row_1",
        "columns": null
      }
    },
    {
      "label": "Unavailable product",
      "type": "textfield",
      "id": "Field_ProductId_Replace",
      "key": "productId",
      "readonly": true,
      "layout": {
        "row": "Row_Product",
        "columns": null
      }
    },
    {
      "label": "Replacement Choice",
      "type": "radio",
      "id": "Field_ReplacementChoice",
      "key": "replacementChoice",
      "defaultValue": "replace",
      "values": [
        {
          "label": "Replace unavailable product with alternative",
          "value": "replace"
        },
        {
          "label": "Remove unavailable product from basket",
          "value": "remove"
        }
      ],
      "validate": {
        "required": true
      },
      "layout": {
        "row": "Row_2",
        "columns": null
      }
    },
    {
      "label": "Replacement product",
      "type": "select",
      "id": "Field_ReplacementProductId",
      "key": "replacementProductId",
      "description": "The stock check runs again with this product and the current quantity.",
      "values": [
        {
          "label": "Apple box (apple-box)",
          "value": "apple-box"
        },
        {
          "label": "Bread loaf (bread-loaf)",
          "value": "bread-loaf"
        }
      ],
      "conditional": {
        "hide": "= replacementChoice != \"replace\""
      },
      "validate": {
        "required": true
      },
      "layout": {
        "row": "Row_3",
        "columns": null
      }
    }
  ],
  "type": "default"
}