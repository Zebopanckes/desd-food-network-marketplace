{
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.9.0",
  "exporter": {
    "name": "Camunda Web Modeler",
    "version": "64767e4"
  },
  "schemaVersion": 16,
  "id": "form-review-and-confirm-order",
  "components": [
    {
      "text": "### Review and Confirm Order\nReview the demo producer breakdown and delivery arrangements. Confirm to proceed; otherwise select amend or cancel. Start variable customerConfirmed pre-fills the checkbox but you must still submit this form.",
      "type": "text",
      "id": "Field_Header_Review",
      "layout": {
        "row": "Row_0",
        "columns": null
      }
    },
    {
      "label": "Producer breakdown (demo)",
      "type": "textfield",
      "id": "Field_ProducerSummary",
      "key": "producerSummary",
      "readonly": true,
      "layout": {
        "row": "Row_Producers",
        "columns": null
      }
    },
    {
      "label": "Basket ID",
      "type": "textfield",
      "id": "Field_BasketId_Review",
      "key": "basketId",
      "readonly": true,
      "layout": {
        "row": "Row_1",
        "columns": null
      }
    },
    {
      "label": "Product",
      "type": "textfield",
      "id": "Field_ProductId_Review",
      "key": "productId",
      "readonly": true,
      "layout": {
        "row": "Row_Product",
        "columns": null
      }
    },
    {
      "label": "Delivery or Collection Arrangements Summary",
      "type": "textfield",
      "id": "Field_DeliverySummary",
      "key": "deliveryArrangementsSummary",
      "description": "Populated by Determine delivery or collection arrangements service task",
      "readonly": true,
      "layout": {
        "row": "Row_2",
        "columns": null
      }
    },
    {
      "label": "Confirm order and proceed to payment",
      "type": "checkbox",
      "id": "Field_CustomerConfirmed",
      "key": "customerConfirmed",
      "description": "Checked = true (routes 'Customer confirmed?' gateway to Order creation and retry)",
      "defaultValue": false,
      "layout": {
        "row": "Row_3",
        "columns": null
      }
    },
    {
      "label": "If not confirming, select action",
      "type": "select",
      "id": "Field_CustomerDecision",
      "key": "customerDecision",
      "description": "Only used when confirm is unchecked. Amend returns to the stock check, then to this review form.",
      "defaultValue": "cancel",
      "conditional": {
        "hide": "= customerConfirmed = true"
      },
      "validate": {
        "required": true
      },
      "values": [
        {
          "label": "Amend basket (return to stock check)",
          "value": "amend"
        },
        {
          "label": "Cancel checkout",
          "value": "cancel"
        }
      ],
      "layout": {
        "row": "Row_4",
        "columns": null
      }
    },
    {
      "label": "New quantity",
      "type": "number",
      "id": "Field_RequestedQuantity_Review",
      "key": "requestedQuantity",
      "description": "The stock check runs again with this quantity before you return to this review.",
      "decimalDigits": 0,
      "conditional": {
        "hide": "= customerConfirmed = true or customerDecision != \"amend\""
      },
      "validate": {
        "required": true,
        "min": 1
      },
      "layout": {
        "row": "Row_Quantity",
        "columns": null
      }
    },
    {
      "label": "Basket amendment notes (demo)",
      "type": "textfield",
      "id": "Field_ReviewAmendment",
      "key": "amendedQuantities",
      "description": "Optional notes on the requested change.",
      "conditional": {
        "hide": "= customerConfirmed = true or customerDecision != \"amend\""
      },
      "layout": {
        "row": "Row_5",
        "columns": null
      }
    }
  ],
  "type": "default"
}