{
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.9.0",
  "exporter": {
    "name": "Camunda Web Modeler",
    "version": "64767e4"
  },
  "schemaVersion": 16,
  "id": "form-inform-and-amend-basket",
  "components": [
    {
      "text": "### Stock Shortage Notice — Amend Basket\nOne or more items in your basket exceed available producer stock. Amend quantities below or flag an unavailable product to remove/replace it.",
      "type": "text",
      "id": "Field_Header_Amend",
      "layout": {
        "row": "Row_0",
        "columns": null
      }
    },
    {
      "label": "Basket ID",
      "type": "textfield",
      "id": "Field_BasketId_Amend",
      "key": "basketId",
      "readonly": true,
      "layout": {
        "row": "Row_1",
        "columns": null
      }
    },
    {
      "label": "Product",
      "type": "textfield",
      "id": "Field_ProductId_Amend",
      "key": "productId",
      "readonly": true,
      "layout": {
        "row": "Row_Product",
        "columns": null
      }
    },
    {
      "label": "New quantity",
      "type": "number",
      "id": "Field_RequestedQuantity_Amend",
      "key": "requestedQuantity",
      "description": "Prefilled with the quantity that failed the stock check. Demo stock: apple-box up to 20, bread-loaf up to 10.",
      "decimalDigits": 0,
      "conditional": {
        "hide": "= unavailableProduct = true"
      },
      "validate": {
        "required": true,
        "min": 1
      },
      "layout": {
        "row": "Row_Quantity",
        "columns": null
      }
    },
    {
      "label": "Amendment notes",
      "type": "textfield",
      "id": "Field_AmendedQuantities",
      "key": "amendedQuantities",
      "description": "Optional notes on the change (for example, apples: 2, sourdough: 1).",
      "layout": {
        "row": "Row_2",
        "columns": null
      }
    },
    {
      "label": "Product is completely unavailable (remove or replace item instead)",
      "type": "checkbox",
      "id": "Field_UnavailableProduct",
      "key": "unavailableProduct",
      "description": "Checked = true routes 'Unavailable product?' gateway to 'Remove or replace unavailable product'",
      "defaultValue": false,
      "layout": {
        "row": "Row_3",
        "columns": null
      }
    }
  ],
  "type": "default"
}