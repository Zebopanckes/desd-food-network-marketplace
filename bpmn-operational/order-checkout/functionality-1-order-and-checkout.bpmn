        <bpmn:incoming>Flow_0c7o2e9</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_1o2s6m4" sourceRef="Event_0o1s7t3" targetRef="Activity_1r4s8t2" />
      <bpmn:sequenceFlow id="Flow_0r2b9e4" sourceRef="Event_0r5b8e3" targetRef="Event_1r9e2f4" />
      <bpmn:sequenceFlow id="Flow_1r8s3e4" sourceRef="Activity_1r4s8t2" targetRef="Gateway_0m8o3c1" />
      <bpmn:sequenceFlow id="Flow_1m5o9c7" sourceRef="Gateway_0m8o3c1" targetRef="Activity_0c3m8o5" />
      <bpmn:sequenceFlow id="Flow_0c7o2e9" sourceRef="Activity_0c3m8o5" targetRef="Event_0o9e4d2" />
      <bpmn:sequenceFlow id="Flow_1b8e3r6" sourceRef="Event_0b4e9f2" targetRef="Activity_1r6f2e8" />
      <bpmn:sequenceFlow id="Flow_0r3f8g1" sourceRef="Activity_1r6f2e8" targetRef="Gateway_1r5g9y3" />
      <bpmn:sequenceFlow id="Flow_0r9y4l2" name="Retry (retryCount &#60; 3)" sourceRef="Gateway_1r5g9y3" targetRef="Gateway_0m8o3c1">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= retryCount &lt; 3</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_1r2n7e4" name="Escalate" sourceRef="Gateway_1r5g9y3" targetRef="Activity_1n7c3f5" />
      <bpmn:sequenceFlow id="Flow_0n4c8e2" sourceRef="Activity_1n7c3f5" targetRef="Event_1e8o3f6" />
    </bpmn:subProcess>
    <bpmn:serviceTask id="Activity_0r8l2s4" name="Release stock reservation">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="release-stock-reservation" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0e9b2f4</bpmn:incoming>
      <bpmn:outgoing>Flow_1r5l9e2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Event_1f7e2m9" name="Order failed after retries">
      <bpmn:incoming>Flow_1r5l9e2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Activity_1s8p4e6" name="Split into producer-specific order elements">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="split-producer-order-elements" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0o6c2s8</bpmn:incoming>
      <bpmn:outgoing>Flow_1s3p9h4</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics>
        <bpmn:extensionElements>
          <zeebe:loopCharacteristics inputCollection="=orderProducers" inputElement="producer" outputCollection="producerSubOrders" outputElement="=producerSubOrder" />
        </bpmn:extensionElements>
      </bpmn:multiInstanceLoopCharacteristics>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Event_0p2r8q5" name="Payment requested">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-payment-requested" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1s3p9h4</bpmn:incoming>
      <bpmn:messageEventDefinition id="MessageEventDefinition_1p6r4q8" messageRef="Message_1p7r3m9" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1a2b4c6" sourceRef="Event_0s9t3c1" targetRef="Gateway_1m3s8c4" />
    <bpmn:sequenceFlow id="Flow_0t5c9s3" sourceRef="Gateway_1m3s8c4" targetRef="Activity_0c7s2a4" />
