        <bpmn:incoming>Flow_1r8s3e4</bpmn:incoming>
        <bpmn:incoming>Flow_0r9y4l2</bpmn:incoming>
        <bpmn:outgoing>Flow_1m5o9c7</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="Activity_0c3m8o5" name="Create marketplace order">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="create-marketplace-order" retries="1" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_1m5o9c7</bpmn:incoming>
        <bpmn:outgoing>Flow_0c7o2e9</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:boundaryEvent id="Event_0b4e9f2" name="Order creation failed" attachedToRef="Activity_0c3m8o5">
        <bpmn:outgoing>Flow_1b8e3r6</bpmn:outgoing>
        <bpmn:errorEventDefinition id="ErrorEventDefinition_1e7f2c4" errorRef="Error_1x9p2k4" />
      </bpmn:boundaryEvent>
      <bpmn:serviceTask id="Activity_1r6f2e8" name="Record failure and increment retry counter">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="record-order-creation-failure" retries="3" />
          <zeebe:ioMapping>
            <zeebe:output source="= retryCount + 1" target="retryCount" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_1b8e3r6</bpmn:incoming>
        <bpmn:outgoing>Flow_0r3f8g1</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="Gateway_1r5g9y3" name="Retry order creation?" default="Flow_1r2n7e4">
        <bpmn:incoming>Flow_0r3f8g1</bpmn:incoming>
        <bpmn:outgoing>Flow_0r9y4l2</bpmn:outgoing>
        <bpmn:outgoing>Flow_1r2n7e4</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sendTask id="Activity_1n7c3f5" name="Notify customer of order failure">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="notify-customer-order-failure" retries="3" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_1r2n7e4</bpmn:incoming>
        <bpmn:outgoing>Flow_0n4c8e2</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:endEvent id="Event_1e8o3f6" name="Order creation escalated">
        <bpmn:incoming>Flow_0n4c8e2</bpmn:incoming>
        <bpmn:errorEventDefinition id="ErrorEventDefinition_0e2x9f7" errorRef="Error_1x9p2k4" />
