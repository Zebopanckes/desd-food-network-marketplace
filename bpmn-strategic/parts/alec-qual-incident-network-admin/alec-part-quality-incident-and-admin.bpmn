  <bpmndi:BPMNDiagram id="BPMNDiagram_RC">
    <bpmndi:BPMNPlane id="BPMNPlane_RC" bpmnElement="SubProcess_ReviewClose">
      <bpmndi:BPMNShape id="StartEvent_RC_Inner_di" bpmnElement="StartEvent_RC_Inner">
        <dc:Bounds x="200" y="142" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="206" y="185" width="24" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RC_Placeholder_di" bpmnElement="Task_RC_Placeholder">
        <dc:Bounds x="290" y="120" width="140" height="80" />
