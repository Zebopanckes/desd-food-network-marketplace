      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_QI_Placeholder_di" bpmnElement="Task_QI_Placeholder">
        <dc:Bounds x="290" y="120" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_QI_Inner_di" bpmnElement="EndEvent_QI_Inner">
