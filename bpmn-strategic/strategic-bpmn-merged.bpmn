<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_Strategic" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Web Modeler" exporterVersion="f127538" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.10.0">
  <bpmn:message id="Message_ListingSubmitted" name="Listing submitted" />
  <bpmn:message id="Message_CertCheckRequest" name="Certification check request" />
  <bpmn:message id="Message_CertResult" name="Certification result" />
  <bpmn:message id="Message_OrderPlaced" name="Customer order placed" />
  <bpmn:message id="Message_ProducerOrder" name="Producer order" />
  <bpmn:message id="Message_PaymentRequest" name="Payment request" />
  <bpmn:message id="Message_PaymentResult" name="Payment result" />
  <bpmn:message id="Message_Confirmation" name="Confirmation to customer" />
  <bpmn:message id="Message_WeeklySettlement" name="Weekly settlement" />
  <bpmn:message id="Message_ConcernReported" name="Concern reported" />
  <bpmn:message id="Message_IncidentResponse" name="Incident response request" />
  <bpmn:message id="Message_SafetyNotice" name="Safety notice" />
  <bpmn:dataStore id="DataStore_Records" name="Customer, product and producer records" />
  <bpmn:collaboration id="Collaboration_Strategic" name="Strategic BPMN: Bristol Regional Food Network">
    <bpmn:participant id="Participant_Customers" name="Customers" processRef="Process_Customers" />
    <bpmn:participant id="Participant_Marketplace" name="Marketplace" processRef="Process_Marketplace" />
    <bpmn:participant id="Participant_Producers" name="Producers" processRef="Process_Producers" />
    <bpmn:participant id="Participant_Payment" name="Payment service" />
    <bpmn:participant id="Participant_Cert" name="Organic certification service" />
    <bpmn:messageFlow id="MF_OrderPlaced" sourceRef="Task_PlaceOrder" targetRef="Start_OrderPlaced" messageRef="Message_OrderPlaced" />
    <bpmn:messageFlow id="MF_Confirmation" name="Confirmation to customer" sourceRef="Sub_PaymentSettlement" targetRef="Task_ReceiveConfirmation" messageRef="Message_Confirmation" />
    <bpmn:messageFlow id="MF_Concern" sourceRef="Task_ReportConcern" targetRef="Start_ConcernReported" messageRef="Message_ConcernReported" />
    <bpmn:messageFlow id="MF_Safety" name="Safety notice" sourceRef="Sub_QualityIncident" targetRef="Start_SafetyNoticeReceived" messageRef="Message_SafetyNotice" />
    <bpmn:messageFlow id="MF_Listing" name="Listing submitted" sourceRef="Task_ListProducts" targetRef="Start_ListingSubmitted" messageRef="Message_ListingSubmitted" />
    <bpmn:messageFlow id="MF_ProducerOrder" sourceRef="Sub_OrderCheckout" targetRef="Task_PrepareOrders" messageRef="Message_ProducerOrder" />
    <bpmn:messageFlow id="MF_Weekly" sourceRef="Sub_PaymentSettlement" targetRef="Task_ReceiveSettlement" messageRef="Message_WeeklySettlement" />
    <bpmn:messageFlow id="MF_Incident" sourceRef="Sub_QualityIncident" targetRef="Start_IncidentRequested" messageRef="Message_IncidentResponse" />
    <bpmn:messageFlow id="MF_CertRequest" name="Certification check request" sourceRef="Sub_ListManage" targetRef="Participant_Cert" messageRef="Message_CertCheckRequest" />
    <bpmn:messageFlow id="MF_CertResult" name="Certification result" sourceRef="Participant_Cert" targetRef="Sub_ListManage" messageRef="Message_CertResult" />
    <bpmn:messageFlow id="MF_PayRequest" name="Payment request" sourceRef="Sub_PaymentSettlement" targetRef="Participant_Payment" messageRef="Message_PaymentRequest" />
    <bpmn:messageFlow id="MF_PayResult" name="Payment result" sourceRef="Participant_Payment" targetRef="Sub_PaymentSettlement" messageRef="Message_PaymentResult" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Customers" name="Customers" isExecutable="false">
    <bpmn:task id="Task_Browse" name="Browse and search products">
      <bpmn:incoming>F_c1</bpmn:incoming>
      <bpmn:outgoing>F_c2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_PlaceOrder" name="Place order and pay">
      <bpmn:incoming>F_c2</bpmn:incoming>
      <bpmn:outgoing>F_c3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ReceiveConfirmation" name="Receive confirmation, delivery or collection">
      <bpmn:incoming>F_c3</bpmn:incoming>
      <bpmn:outgoing>F_c4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="F_c1" sourceRef="Start_NeedsLocalFood" targetRef="Task_Browse" />
    <bpmn:sequenceFlow id="F_c2" sourceRef="Task_Browse" targetRef="Task_PlaceOrder" />
    <bpmn:sequenceFlow id="F_c3" sourceRef="Task_PlaceOrder" targetRef="Task_ReceiveConfirmation" />
    <bpmn:sequenceFlow id="F_c4" sourceRef="Task_ReceiveConfirmation" targetRef="End_NeedsMet" />
    <bpmn:startEvent id="Start_SafetyNoticeReceived" name="Safety notice received">
      <bpmn:outgoing>F_c7</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_Start_SafetyNoticeReceived" messageRef="Message_SafetyNotice" />
    </bpmn:startEvent>
    <bpmn:task id="Task_ActOnNotice" name="Act on safety notice">
      <bpmn:incoming>F_c7</bpmn:incoming>
      <bpmn:outgoing>F_c8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_NoticeActioned" name="Notice actioned">
      <bpmn:incoming>F_c8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_c7" sourceRef="Start_SafetyNoticeReceived" targetRef="Task_ActOnNotice" />
    <bpmn:sequenceFlow id="F_c8" sourceRef="Task_ActOnNotice" targetRef="End_NoticeActioned" />
    <bpmn:startEvent id="Start_ConcernNoticed" name="Quality concern noticed">
      <bpmn:outgoing>F_c5</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_ReportConcern" name="Report food quality concern">
      <bpmn:incoming>F_c5</bpmn:incoming>
      <bpmn:outgoing>F_c6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_ConcernReported" name="Concern reported">
      <bpmn:incoming>F_c6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_c5" sourceRef="Start_ConcernNoticed" targetRef="Task_ReportConcern" />
    <bpmn:sequenceFlow id="F_c6" sourceRef="Task_ReportConcern" targetRef="End_ConcernReported" />
    <bpmn:startEvent id="Start_NeedsLocalFood" name="Needs local food">
      <bpmn:outgoing>F_c1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="End_NeedsMet" name="Needs met">
      <bpmn:incoming>F_c4</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmn:process id="Process_Marketplace" name="Marketplace" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Marketplace">
      <bpmn:lane id="Lane_Product" name="Product and Inventory Management">
        <bpmn:flowNodeRef>Sub_ListManage</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_ProductsListed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Start_ListingSubmitted</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Order" name="Order and Checkout">
        <bpmn:flowNodeRef>Start_OrderPlaced</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Sub_OrderCheckout</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Payment" name="Payments and Settlement">
        <bpmn:flowNodeRef>Sub_PaymentSettlement</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_OrderConfirmed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Quality" name="Quality and Traceability">
        <bpmn:flowNodeRef>Start_ConcernReported</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Sub_QualityIncident</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Admin" name="Network Administration and Sustainability">
        <bpmn:flowNodeRef>Start_Monthly</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_ReportsPublished</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_IncidentClosed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Sub_Community</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Sub_ReviewClose</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:sequenceFlow id="F_m5" sourceRef="Sub_PaymentSettlement" targetRef="End_OrderConfirmed" />
    <bpmn:sequenceFlow id="F_m4" sourceRef="Sub_OrderCheckout" targetRef="Sub_PaymentSettlement" />
    <bpmn:sequenceFlow id="F_m3" sourceRef="Start_OrderPlaced" targetRef="Sub_OrderCheckout" />
    <bpmn:subProcess id="Sub_OrderCheckout" name="Order and checkout">
      <bpmn:incoming>F_m3</bpmn:incoming>
      <bpmn:outgoing>F_m4</bpmn:outgoing>
      <bpmn:startEvent id="Sub_OrderCheckout_S" name="Start">
        <bpmn:outgoing>Sub_OrderCheckout_F1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="Sub_OrderCheckout_T" name="Placeholder: detail in Sprint 2">
        <bpmn:incoming>Sub_OrderCheckout_F1</bpmn:incoming>
        <bpmn:outgoing>Sub_OrderCheckout_F2</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="Sub_OrderCheckout_E" name="End">
        <bpmn:incoming>Sub_OrderCheckout_F2</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Sub_OrderCheckout_F1" sourceRef="Sub_OrderCheckout_S" targetRef="Sub_OrderCheckout_T" />
      <bpmn:sequenceFlow id="Sub_OrderCheckout_F2" sourceRef="Sub_OrderCheckout_T" targetRef="Sub_OrderCheckout_E" />
    </bpmn:subProcess>
    <bpmn:startEvent id="Start_OrderPlaced" name="Customer order placed">
      <bpmn:outgoing>F_m3</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_Start_OrderPlaced" messageRef="Message_OrderPlaced" />
    </bpmn:startEvent>
    <bpmn:startEvent id="Start_Monthly" name="Monthly">
      <bpmn:outgoing>F_m9</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TED_Start_Monthly" />
    </bpmn:startEvent>
    <bpmn:subProcess id="Sub_Community" name="Community and sustainability reporting">
      <bpmn:incoming>F_m9</bpmn:incoming>
      <bpmn:outgoing>F_m10</bpmn:outgoing>
      <bpmn:startEvent id="Sub_Community_S" name="Start">
        <bpmn:outgoing>Sub_Community_F1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="Sub_Community_T" name="Placeholder: detail in Sprint 2">
        <bpmn:incoming>Sub_Community_F1</bpmn:incoming>
        <bpmn:outgoing>Sub_Community_F2</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="Sub_Community_E" name="End">
        <bpmn:incoming>Sub_Community_F2</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Sub_Community_F1" sourceRef="Sub_Community_S" targetRef="Sub_Community_T" />
      <bpmn:sequenceFlow id="Sub_Community_F2" sourceRef="Sub_Community_T" targetRef="Sub_Community_E" />
    </bpmn:subProcess>
    <bpmn:endEvent id="End_ReportsPublished" name="Reports and offers published">
      <bpmn:incoming>F_m10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="Start_ConcernReported" name="Quality concern reported">
      <bpmn:outgoing>F_m6</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_Start_ConcernReported" messageRef="Message_ConcernReported" />
    </bpmn:startEvent>
    <bpmn:subProcess id="Sub_QualityIncident" name="Quality incident handling">
      <bpmn:incoming>F_m6</bpmn:incoming>
      <bpmn:outgoing>F_m7</bpmn:outgoing>
      <bpmn:property id="Property_Records" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DataInputAssociation_Records">
        <bpmn:sourceRef>DataStoreRef_Records</bpmn:sourceRef>
        <bpmn:targetRef>Property_Records</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:startEvent id="Sub_QualityIncident_S" name="Start">
        <bpmn:outgoing>Sub_QualityIncident_F1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="Sub_QualityIncident_T" name="Placeholder: detail in Sprint 2">
        <bpmn:incoming>Sub_QualityIncident_F1</bpmn:incoming>
        <bpmn:outgoing>Sub_QualityIncident_F2</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="Sub_QualityIncident_E" name="End">
        <bpmn:incoming>Sub_QualityIncident_F2</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Sub_QualityIncident_F1" sourceRef="Sub_QualityIncident_S" targetRef="Sub_QualityIncident_T" />
      <bpmn:sequenceFlow id="Sub_QualityIncident_F2" sourceRef="Sub_QualityIncident_T" targetRef="Sub_QualityIncident_E" />
    </bpmn:subProcess>
    <bpmn:dataStoreReference id="DataStoreRef_Records" name="Customer, product and producer records" dataStoreRef="DataStore_Records" />
    <bpmn:subProcess id="Sub_ReviewClose" name="Review and close incident">
      <bpmn:incoming>F_m7</bpmn:incoming>
      <bpmn:outgoing>F_m8</bpmn:outgoing>
      <bpmn:startEvent id="Sub_ReviewClose_S" name="Start">
        <bpmn:outgoing>Sub_ReviewClose_F1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="Sub_ReviewClose_T" name="Placeholder: detail in Sprint 2">
        <bpmn:incoming>Sub_ReviewClose_F1</bpmn:incoming>
        <bpmn:outgoing>Sub_ReviewClose_F2</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="Sub_ReviewClose_E" name="End">
        <bpmn:incoming>Sub_ReviewClose_F2</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Sub_ReviewClose_F1" sourceRef="Sub_ReviewClose_S" targetRef="Sub_ReviewClose_T" />
      <bpmn:sequenceFlow id="Sub_ReviewClose_F2" sourceRef="Sub_ReviewClose_T" targetRef="Sub_ReviewClose_E" />
    </bpmn:subProcess>
    <bpmn:endEvent id="End_IncidentClosed" name="Incident closed">
      <bpmn:incoming>F_m8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_m9" sourceRef="Start_Monthly" targetRef="Sub_Community" />
    <bpmn:sequenceFlow id="F_m10" sourceRef="Sub_Community" targetRef="End_ReportsPublished" />
    <bpmn:sequenceFlow id="F_m6" sourceRef="Start_ConcernReported" targetRef="Sub_QualityIncident" />
    <bpmn:sequenceFlow id="F_m7" sourceRef="Sub_QualityIncident" targetRef="Sub_ReviewClose" />
    <bpmn:sequenceFlow id="F_m8" sourceRef="Sub_ReviewClose" targetRef="End_IncidentClosed" />
    <bpmn:subProcess id="Sub_PaymentSettlement" name="Payment and settlement">
      <bpmn:incoming>F_m4</bpmn:incoming>
      <bpmn:outgoing>F_m5</bpmn:outgoing>
      <bpmn:startEvent id="Sub_PaymentSettlement_S" name="Start">
        <bpmn:outgoing>Sub_PaymentSettlement_F1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="Sub_PaymentSettlement_T" name="Placeholder: detail in Sprint 2">
        <bpmn:incoming>Sub_PaymentSettlement_F1</bpmn:incoming>
        <bpmn:outgoing>Sub_PaymentSettlement_F2</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="Sub_PaymentSettlement_E" name="End">
        <bpmn:incoming>Sub_PaymentSettlement_F2</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Sub_PaymentSettlement_F1" sourceRef="Sub_PaymentSettlement_S" targetRef="Sub_PaymentSettlement_T" />
      <bpmn:sequenceFlow id="Sub_PaymentSettlement_F2" sourceRef="Sub_PaymentSettlement_T" targetRef="Sub_PaymentSettlement_E" />
    </bpmn:subProcess>
    <bpmn:subProcess id="Sub_ListManage" name="List and manage products">
      <bpmn:incoming>F_m1</bpmn:incoming>
      <bpmn:outgoing>F_m2</bpmn:outgoing>
      <bpmn:startEvent id="Sub_ListManage_S" name="Start">
        <bpmn:outgoing>Sub_ListManage_F1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="Sub_ListManage_T" name="Placeholder: detail in Sprint 2">
        <bpmn:incoming>Sub_ListManage_F1</bpmn:incoming>
        <bpmn:outgoing>Sub_ListManage_F2</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="Sub_ListManage_E" name="End">
        <bpmn:incoming>Sub_ListManage_F2</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Sub_ListManage_F1" sourceRef="Sub_ListManage_S" targetRef="Sub_ListManage_T" />
      <bpmn:sequenceFlow id="Sub_ListManage_F2" sourceRef="Sub_ListManage_T" targetRef="Sub_ListManage_E" />
    </bpmn:subProcess>
    <bpmn:endEvent id="End_ProductsListed" name="Products listed and in stock">
      <bpmn:incoming>F_m2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_m1" sourceRef="Start_ListingSubmitted" targetRef="Sub_ListManage" />
    <bpmn:sequenceFlow id="F_m2" sourceRef="Sub_ListManage" targetRef="End_ProductsListed" />
    <bpmn:startEvent id="Start_ListingSubmitted" name="Listing submitted">
      <bpmn:outgoing>F_m1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_Start_ListingSubmitted" messageRef="Message_ListingSubmitted" />
    </bpmn:startEvent>
    <bpmn:endEvent id="End_OrderConfirmed" name="Order confirmed and producers paid">
      <bpmn:incoming>F_m5</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmn:process id="Process_Producers" name="Producers" isExecutable="false">
    <bpmn:startEvent id="Start_HasProduce" name="Has produce to sell">
      <bpmn:outgoing>F_p1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_ListProducts" name="List products and update seasonal stock">
      <bpmn:incoming>F_p1</bpmn:incoming>
      <bpmn:outgoing>F_p2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_PrepareOrders" name="Receive and prepare orders (48h notice)">
      <bpmn:incoming>F_p2</bpmn:incoming>
      <bpmn:outgoing>F_p3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ReceiveSettlement" name="Receive weekly settlement">
      <bpmn:incoming>F_p3</bpmn:incoming>
      <bpmn:outgoing>F_p4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:startEvent id="Start_IncidentRequested" name="Incident response requested">
      <bpmn:outgoing>F_p5</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_Start_IncidentRequested" messageRef="Message_IncidentResponse" />
    </bpmn:startEvent>
    <bpmn:task id="Task_RespondIncident" name="Respond to quality incident">
      <bpmn:incoming>F_p5</bpmn:incoming>
      <bpmn:outgoing>F_p6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_IncidentResponded" name="Incident responded">
      <bpmn:incoming>F_p6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_p1" sourceRef="Start_HasProduce" targetRef="Task_ListProducts" />
    <bpmn:sequenceFlow id="F_p2" sourceRef="Task_ListProducts" targetRef="Task_PrepareOrders" />
    <bpmn:sequenceFlow id="F_p3" sourceRef="Task_PrepareOrders" targetRef="Task_ReceiveSettlement" />
    <bpmn:sequenceFlow id="F_p4" sourceRef="Task_ReceiveSettlement" targetRef="End_ProduceSold" />
    <bpmn:sequenceFlow id="F_p5" sourceRef="Start_IncidentRequested" targetRef="Task_RespondIncident" />
    <bpmn:sequenceFlow id="F_p6" sourceRef="Task_RespondIncident" targetRef="End_IncidentResponded" />
    <bpmn:endEvent id="End_ProduceSold" name="Produce sold">
      <bpmn:incoming>F_p4</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Main">
    <bpmndi:BPMNPlane id="BPMNPlane_Main" bpmnElement="Collaboration_Strategic">
      <bpmndi:BPMNShape id="Participant_Customers_di" bpmnElement="Participant_Customers" isHorizontal="true">
